# -*- coding: utf-8 -*-
"""
DevEnterpriseAI环境变量配置文件

请复制此文件为.env并填写实际配置值。
所有敏感信息（API密钥等）必须通过此文件管理，禁止硬编码。
"""

# ==================== 项目配置 ====================
PROJECT_NAME=DevEnterpriseAI
ENVIRONMENT=production
DEBUG=false

# ==================== 大语言模型配置 ====================
# API密钥（必填）
LLM_API_KEY=your-api-key-here

# API地址（私有化部署时填写，兼容OpenAI格式）
LLM_BASE_URL=https://api.openai.com/v1

# 模型名称
LLM_MODEL_NAME=gpt-4

# 生成温度参数（0.0-2.0）
LLM_TEMPERATURE=0.7

# 最大生成Token数
LLM_MAX_TOKENS=2048

# 请求超时时间（秒）
LLM_TIMEOUT=60

# 是否启用流式输出
LLM_STREAMING=false

# ==================== 向量库配置 ====================
# 向量库持久化目录
VECTORSTORE_PERSIST_DIRECTORY=./knowledge/vectorstore

# 嵌入模型名称
VECTORSTORE_EMBEDDING_MODEL=text-embedding-ada-002

# 嵌入向量维度
VECTORSTORE_EMBEDDING_DIMENSION=1536

# 文档分块大小
VECTORSTORE_CHUNK_SIZE=500

# 文档分块重叠大小
VECTORSTORE_CHUNK_OVERLAP=50

# ==================== 内存配置 ====================
# 最大对话历史条数
MEMORY_MAX_HISTORY=100

# 会话超时时间（秒）
MEMORY_SESSION_TIMEOUT=3600

# 内存类型（buffer/conversation_summary）
MEMORY_TYPE=buffer

# ==================== 知识库配置 ====================
# 知识库索引名称
KNOWLEDGE_INDEX_NAME=knowledge_base

# 最大文件大小（字节）
KNOWLEDGE_MAX_FILE_SIZE=10485760

# ==================== 日志配置 ====================
# 日志级别（DEBUG/INFO/WARNING/ERROR/CRITICAL）
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE_PATH=./logs/app.log

# 日志文件最大大小（字节）
LOG_MAX_BYTES=10485760

# 日志文件保留份数
LOG_BACKUP_COUNT=5

# 是否输出到控制台
LOG_CONSOLE_OUTPUT=true
